generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  name           String
  username       String   @unique
  email          String   @unique
  password       String
  rating         Int      @default(400)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  gamesAsPlayer1 Game[]   @relation("Player1Games")
  gamesAsPlayer2 Game[]   @relation("Player2Games")
  authProvider   Provider @default(email)

  @@map("users")
}

model Game {
  id             String   @id @default(cuid())
  roomID         String   @unique
  player1        User     @relation("Player1Games", fields: [player1ID], references: [username])
  player1ID      String
  player2        User     @relation("Player2Games", fields: [player2ID], references: [username])
  player2ID      String
  winner         String?
  runnerup       String?
  moves          Move[]   @relation("GameMoves")
  createdAt      DateTime @default(now())
  status         State    @default(start)
  winnerPoints   Int      @default(0)
  runnerupPoints Int      @default(0)

  @@map("games")
}

model Move {
  id        String   @id @default(cuid())
  roomID    String
  game      Game     @relation("GameMoves", fields: [roomID], references: [roomID], onDelete: Cascade)
  playerID  String
  piece     String
  from      String
  to        String
  time      Int
  points    Int      @default(0)
  promotion Promotion?  // null for normal moves, 'q'|'r'|'b'|'n' for pawn promotions
  createdAt DateTime @default(now())

  @@map("moves")
}


enum State {
  start
  finished
}

enum Provider {
  google
  github
  email
}

enum Promotion{
  q
  r
  b
  n
}

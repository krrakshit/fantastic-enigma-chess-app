generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id        String   @id @default(cuid())
  roomID    String   @unique
  player1id String   
  player2id String   
  Winner    String?   
  Runnerup  String?   
  moves     Move[]   @relation("GameMoves")
  createdAt DateTime @default(now())
  status    State    @default(start)
  Winnerpoints Int   @default(0)
  RunnerupPoints Int @default(0)
}

model Move {
  id        String   @id @default(cuid())
  roomID    String
  game      Game     @relation("GameMoves", fields: [roomID], references: [roomID], onDelete: Cascade)
  playerID  String
  piece     String
  from      String
  to        String
  time      Int
  points    Int    @default(0)
  createdAt DateTime @default(now())

  @@map("moves")
}

enum State{
  start
  finished
}

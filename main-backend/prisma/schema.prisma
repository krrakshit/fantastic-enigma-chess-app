generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(cuid())
  name           String
  username       String           @unique
  email          String           @unique
  password       String
  rating         Int              @default(400)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  gamesAsPlayer1 Game[]           @relation("Player1Games")
  gamesAsPlayer2 Game[]           @relation("Player2Games")
  authProvider   Provider         @default(email)
  preferences    UserPreferences?
  ratingHistory  RatingHistory[]

  @@map("users")
}

model Game {
  id             String         @id @default(cuid())
  roomID         String         @unique
  player1        User           @relation("Player1Games", fields: [player1ID], references: [username])
  player1ID      String
  player2        User           @relation("Player2Games", fields: [player2ID], references: [username])
  player2ID      String
  winner         String?
  runnerup       String?
  moves          Move[]         @relation("GameMoves")
  analysis       GameAnalysis?  @relation("GameAnalysis")
  createdAt      DateTime       @default(now())
  status         State          @default(start)
  result         GameResult?    // how the game ended (null while in progress)
  winnerPoints   Int            @default(0)
  runnerupPoints Int            @default(0)
  ratingHistory  RatingHistory[] @relation("GameRatingHistory")

  @@map("games")
}

model GameAnalysis {
  id          String              @id @default(cuid())
  roomID      String              @unique
  game        Game                @relation("GameAnalysis", fields: [roomID], references: [roomID], onDelete: Cascade)
  moves       AnalysedMove[]      @relation("AnalysisMoves")
  createdAt   DateTime            @default(now())

  @@map("game_analyses")
}

model AnalysedMove {
  id              String        @id @default(cuid())
  analysisId      String
  analysis        GameAnalysis   @relation("AnalysisMoves", fields: [analysisId], references: [id], onDelete: Cascade)
  moveNumber      Int
  move            String         // UCI notation e.g. "e2e4"
  color           String         // "white" | "black"
  score           Int?           // centipawns (null if mate)
  mate            Int?           // moves to mate (null if not)
  bestMove        String?        // engine's best suggestion
  classification  String         // best|excellent|good|inaccuracy|mistake|blunder

  @@map("analysed_moves")
}

model Move {
  id        String   @id @default(cuid())
  roomID    String
  game      Game     @relation("GameMoves", fields: [roomID], references: [roomID], onDelete: Cascade)
  playerID  String
  piece     String
  from      String
  to        String
  time      Int
  points    Int      @default(0)
  promotion Promotion?  // null for normal moves, 'q'|'r'|'b'|'n' for pawn promotions
  createdAt DateTime @default(now())

  @@map("moves")
}

model UserPreferences {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardTheme   String  @default("emerald")
  pieceSet     String  @default("classic")
  soundEnabled Boolean @default(true)

  @@map("user_preferences")
}

model RatingHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  change    Int      // +12 or -8
  gameId    String
  game      Game     @relation("GameRatingHistory", fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("rating_history")
}

enum State {
  start
  finished
}

enum GameResult {
  checkmate
  resign
  timeout
  stalemate
  draw_agreement
  threefold
  insufficient
  fifty_move
}

enum Provider {
  google
  github
  email
}

enum Promotion{
  q
  r
  b
  n
}

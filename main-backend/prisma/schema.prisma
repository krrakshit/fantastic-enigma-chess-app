generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id        String   @id @default(cuid())
  roomID    String   @unique
  player1id String   @unique
  player2id String   @unique
  moves     Move[]   @relation("GameMoves")
  createdAt DateTime @default(now())
  status    State    @default("start")
}

model Move {
  id        String   @id @default(cuid())
  roomID    String
  game      Game     @relation("GameMoves", fields: [roomID], references: [roomID], onDelete: Cascade)
  playerID  String
  piece     String
  from      String
  to        String
  createdAt DateTime @default(now())

  @@map("moves")
}

enum State{
  start
  finished
}
